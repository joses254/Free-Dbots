<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable type="" id="tradeLot">tradeLot</variable>
    <variable type="" id="targetProfit">targetProfit</variable>
    <variable type="" id="stopLossLimit">stopLossLimit</variable>
    <variable type="" id="currentProfit">currentProfit</variable>
    <variable type="" id="lastTick">lastTick</variable>
  </variables>
  
  <!-- BLOCK 1: TRADE PARAMETERS -->
  <block type="trade_definition" id="trade_def" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="market_def">
        <field name="MARKET_LIST">commodities</field>
        <field name="SUBMARKET_LIST">metals</field>
        <field name="SYMBOL_LIST">frxXAUUSD</field>
        <next>
          <block type="trade_definition_tradetype" id="type_def">
            <field name="TRADETYPECAT_LIST">callput</field>
            <field name="TRADETYPE_LIST">risefall</field>
            <next>
              <block type="trade_definition_contracttype" id="contract_def">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="interval_def">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restart_def">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="error_def">
                            <field name="RESTARTONERROR_ENABLED">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_lot">
        <field name="VAR" id="tradeLot">tradeLot</field>
        <value name="VALUE">
          <block type="math_number"><field name="NUM">0.01</field></block>
        </value>
        <next>
          <block type="variables_set" id="init_tp">
            <field name="VAR" id="targetProfit">targetProfit</field>
            <value name="VALUE">
              <block type="math_number"><field name="NUM">1.5</field></block>
            </value>
            <next>
              <block type="variables_set" id="init_sl">
                <field name="VAR" id="stopLossLimit">stopLossLimit</field>
                <value name="VALUE">
                  <block type="math_number"><field name="NUM">50</field></block>
                </value>
                <next>
                  <block type="variables_set" id="init_cp">
                    <field name="VAR" id="currentProfit">currentProfit</field>
                    <value name="VALUE">
                      <block type="math_number"><field name="NUM">0</field></block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="options_def">
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <block type="math_number"><field name="NUM">5</field></block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get">
            <field name="VAR" id="tradeLot">tradeLot</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- BLOCK 2: PURCHASE LOGIC (Spike Detection) -->
  <block type="before_purchase" id="purchase_logic" x="700" y="0">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="set_last_tick">
        <field name="VAR" id="lastTick">lastTick</field>
        <value name="VALUE">
          <block type="tick"></block>
        </value>
        <next>
          <block type="controls_if" id="check_spike">
            <mutation elseif="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="bullish_spike">
                <field name="OP">GT</field>
                <value name="A"><block type="tick"></block></value>
                <value name="B">
                  <block type="math_arithmetic">
                    <field name="OP">ADD</field>
                    <value name="A"><block type="variables_get"><field name="VAR" id="lastTick">lastTick</field></block></value>
                    <value name="B"><block type="math_number"><field name="NUM">0.05</field></block></value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="purchase" id="buy_call">
                <field name="PURCHASE_LIST">CALL</field>
              </block>
            </statement>
            <value name="IF1">
              <block type="logic_compare" id="bearish_spike">
                <field name="OP">LT</field>
                <value name="A"><block type="tick"></block></value>
                <value name="B">
                  <block type="math_arithmetic">
                    <field name="OP">MINUS</field>
                    <value name="A"><block type="variables_get"><field name="VAR" id="lastTick">lastTick</field></block></value>
                    <value name="B"><block type="math_number"><field name="NUM">0.05</field></block></value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO1">
              <block type="purchase" id="buy_put">
                <field name="PURCHASE_LIST">PUT</field>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- BLOCK 4: POST-TRADE ANALYSIS -->
  <block type="after_purchase" id="after_logic" x="700" y="450">
    <statement name="AFTERPURCHASE_STACK">
      <block type="variables_set" id="update_profit">
        <field name="VAR" id="currentProfit">currentProfit</field>
        <value name="VALUE">
          <block type="math_arithmetic">
            <field name="OP">ADD</field>
            <value name="A"><block type="variables_get"><field name="VAR" id="currentProfit">currentProfit</field></block></value>
            <value name="B"><block type="read_details"><field name="DETAIL_INDEX">4</field></block></value>
          </block>
        </value>
        <next>
          <block type="controls_if" id="check_limits">
            <mutation elseif="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="tp_reached">
                <field name="OP">GTE</field>
                <value name="A"><block type="variables_get"><field name="VAR" id="currentProfit">currentProfit</field></block></value>
                <value name="B"><block type="variables_get"><field name="VAR" id="targetProfit">targetProfit</field></block></value>
              </block>
            </value>
            <statement name="DO0">
              <block type="text_print" id="print_tp">
                <value name="TEXT"><block type="text"><field name="TEXT">Target Profit Reached!</field></block></value>
              </block>
            </statement>
            <value name="IF1">
              <block type="logic_compare" id="sl_reached">
                <field name="OP">LTE</field>
                <value name="A"><block type="variables_get"><field name="VAR" id="currentProfit">currentProfit</field></block></value>
                <value name="B">
                  <block type="math_single">
                    <field name="OP">NEG</field>
                    <value name="NUM"><block type="variables_get"><field name="VAR" id="stopLossLimit">stopLossLimit</field></block></value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO1">
              <block type="text_print" id="print_sl">
                <value name="TEXT"><block type="text"><field name="TEXT">Stop Loss Hit. Bot Stopped.</field></block></value>
              </block>
            </statement>
            <next>
              <block type="trade_again" id="loop"></block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>