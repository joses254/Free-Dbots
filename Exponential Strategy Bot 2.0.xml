<xml xmlns="http://www.w3.org/1999/xhtml" is_dbot="true" collection="false">
  <variables>
    <variable type="" id="baseStake">Base Stake</variable>
    <variable type="" id="currentStake">Current Stake</variable>
    <variable type="" id="martingaleMultiplier">Martingale Multiplier</variable>
    <variable type="" id="maxMartingaleSteps">Max Martingale Steps</variable>
    <variable type="" id="martingaleStep">Martingale Step</variable>
    <variable type="" id="totalProfit">Total Profit</variable>
    <variable type="" id="profitTarget">Profit Target</variable>
    <variable type="" id="lossLimit">Loss Limit</variable>
    <variable type="" id="digitSampleSize">Digit Sample Size</variable>
    <variable type="" id="over1Count">Over1 Digit Count</variable>
    <variable type="" id="under8Count">Under8 Digit Count</variable>
    <variable type="" id="prevOver1Pct">Previous Over1 %</variable>
    <variable type="" id="prevUnder8Pct">Previous Under8 %</variable>
    <variable type="" id="over1Pct">Over1 %</variable>
    <variable type="" id="under8Pct">Under8 %</variable>
    <variable type="" id="tradeDirection">Trade Direction</variable>
  </variables>

  <!-- ===================== TRADE DEFINITION ===================== -->
  <block type="trade_definition" id="mainTrade" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="marketBlock">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <!-- Change SYMBOL_LIST to the market you want (R_10, R_25, R_50, R_75, 1HZ10V, 1HZ25V, 1HZ50V, 1HZ75V) -->
        <field name="SYMBOL_LIST">1HZ10V</field>
        <next>
          <block type="trade_definition_tradetype" id="tradeTypeBlock">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="contractTypeBlock">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="candleBlock">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="restartBuySell">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="restartOnError">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- ===================== INITIALIZATION ===================== -->
    <statement name="INITIALIZATION">
      <block type="variables_set" id="initBaseStake">
        <field name="VAR" id="baseStake">Base Stake</field>
        <value name="VALUE">
          <block type="math_arithmetic">
            <field name="OP">MULTIPLY</field>
            <value name="A">
              <block type="balance">
                <field name="BALANCE_TYPE">NUM</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number">
                <field name="NUM">0.01</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="variables_set" id="initCurrentStake">
            <field name="VAR" id="currentStake">Current Stake</field>
            <value name="VALUE">
              <block type="variables_get">
                <field name="VAR" id="baseStake">Base Stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="initMultiplier">
                <field name="VAR" id="martingaleMultiplier">Martingale Multiplier</field>
                <value name="VALUE">
                  <block type="math_number">
                    <field name="NUM">2.5</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="initMaxSteps">
                    <field name="VAR" id="maxMartingaleSteps">Max Martingale Steps</field>
                    <value name="VALUE">
                      <block type="math_number">
                        <field name="NUM">4</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="initStep">
                        <field name="VAR" id="martingaleStep">Martingale Step</field>
                        <value name="VALUE">
                          <block type="math_number">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="initProfit">
                            <field name="VAR" id="totalProfit">Total Profit</field>
                            <value name="VALUE">
                              <block type="math_number">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="initSample">
                                <field name="VAR" id="digitSampleSize">Digit Sample Size</field>
                                <value name="VALUE">
                                  <block type="math_number">
                                    <field name="NUM">100</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="initPrevOver">
                                    <field name="VAR" id="prevOver1Pct">Previous Over1 %</field>
                                    <value name="VALUE">
                                      <block type="math_number">
                                        <field name="NUM">10</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="initPrevUnder">
                                        <field name="VAR" id="prevUnder8Pct">Previous Under8 %</field>
                                        <value name="VALUE">
                                          <block type="math_number">
                                            <field name="NUM">10</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="notify" id="startNotify">
                                            <field name="NOTIFICATION_TYPE">success</field>
                                            <field name="NOTIFICATION_SOUND">silent</field>
                                            <value name="MESSAGE">
                                              <block type="text">
                                                <field name="TEXT">Speedbot Scalper started – OVER 1 / UNDER 8 | 1% stake | ×2.5 Martingale (max 4)</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- ===================== BEFORE PURCHASE (ENTRY LOGIC) ===================== -->
    <statement name="BEFORE_PURCHASE">
      <block type="controls_if" id="entryLogic">
        <value name="IF0">
          <block type="logic_operation">
            <field name="OP">AND</field>
            <value name="A">
              <block type="logic_compare">
                <field name="OP">LT</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="martingaleStep">Martingale Step</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get">
                    <field name="VAR" id="maxMartingaleSteps">Max Martingale Steps</field>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="logic_compare">
                <field name="OP">LT</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="totalProfit">Total Profit</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number">
                    <field name="NUM">50</field> <!-- Profit Target – change as needed -->
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <!-- Calculate current digit percentages (simplified) -->
          <block type="variables_set" id="calcOver1">
            <field name="VAR" id="over1Count">Over1 Digit Count</field>
            <value name="VALUE">
              <block type="math_number">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="calcUnder8">
                <field name="VAR" id="under8Count">Under8 Digit Count</field>
                <value name="VALUE">
                  <block type="math_number">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <!-- Here you would loop through lastDigitList and count digits 0+1 and 7+8+9.
                       For brevity this is left as a placeholder. In real use expand with
                       lists_getIndex + controls_for loops on lastDigitList. -->
                  <block type="variables_set" id="setOverPct">
                    <field name="VAR" id="over1Pct">Over1 %</field>
                    <value name="VALUE">
                      <block type="math_arithmetic">
                        <field name="OP">MULTIPLY</field>
                        <value name="A">
                          <block type="math_arithmetic">
                            <field name="OP">DIVIDE</field>
                            <value name="A">
                              <block type="variables_get">
                                <field name="VAR" id="over1Count">Over1 Digit Count</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="variables_get">
                                <field name="VAR" id="digitSampleSize">Digit Sample Size</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number">
                            <field name="NUM">100</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="setUnderPct">
                        <field name="VAR" id="under8Pct">Under8 %</field>
                        <value name="VALUE">
                          <block type="math_arithmetic">
                            <field name="OP">MULTIPLY</field>
                            <value name="A">
                              <block type="math_arithmetic">
                                <field name="OP">DIVIDE</field>
                                <value name="A">
                                  <block type="variables_get">
                                    <field name="VAR" id="under8Count">Under8 Digit Count</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get">
                                    <field name="VAR" id="digitSampleSize">Digit Sample Size</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number">
                                <field name="NUM">100</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <!-- Decision logic -->
                          <block type="controls_if" id="decideDirection">
                            <value name="IF0">
                              <block type="logic_operation">
                                <field name="OP">AND</field>
                                <value name="A">
                                  <block type="logic_compare">
                                    <field name="OP">LT</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="over1Pct">Over1 %</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number">
                                        <field name="NUM">10</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="logic_compare">
                                    <field name="OP">LT</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="over1Pct">Over1 %</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="variables_get">
                                        <field name="VAR" id="prevOver1Pct">Previous Over1 %</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="variables_set" id="setOverDir">
                                <field name="VAR" id="tradeDirection">Trade Direction</field>
                                <value name="VALUE">
                                  <block type="text">
                                    <field name="TEXT">OVER1</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="purchase" id="buyOver">
                                    <field name="PURCHASE_LIST">DIGITOVER</field>
                                  </block>
                                </next>
                              </block>
                            </statement>
                            <value name="IF1">
                              <block type="logic_operation">
                                <field name="OP">AND</field>
                                <value name="A">
                                  <block type="logic_compare">
                                    <field name="OP">LT</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="under8Pct">Under8 %</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number">
                                        <field name="NUM">10</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="logic_compare">
                                    <field name="OP">LT</field>
                                    <value name="A">
                                      <block type="variables_get">
                                        <field name="VAR" id="under8Pct">Under8 %</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="variables_get">
                                        <field name="VAR" id="prevUnder8Pct">Previous Under8 %</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <statement name="DO1">
                              <block type="variables_set" id="setUnderDir">
                                <field name="VAR" id="tradeDirection">Trade Direction</field>
                                <value name="VALUE">
                                  <block type="text">
                                    <field name="TEXT">UNDER8</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="purchase" id="buyUnder">
                                    <field name="PURCHASE_LIST">DIGITUNDER</field>
                                  </block>
                                </next>
                              </block>
                            </statement>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>

    <!-- ===================== AFTER PURCHASE (MARTINGALE + RESET) ===================== -->
    <statement name="AFTER_PURCHASE">
      <block type="controls_if" id="afterPurchaseLogic">
        <value name="IF0">
          <block type="contract_check_result">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <!-- WIN → reset stake & step -->
          <block type="variables_set" id="resetStake">
            <field name="VAR" id="currentStake">Current Stake</field>
            <value name="VALUE">
              <block type="variables_get">
                <field name="VAR" id="baseStake">Base Stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="resetStep">
                <field name="VAR" id="martingaleStep">Martingale Step</field>
                <value name="VALUE">
                  <block type="math_number">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="addProfit">
                    <field name="VAR" id="totalProfit">Total Profit</field>
                    <value name="VALUE">
                      <block type="math_arithmetic">
                        <field name="OP">ADD</field>
                        <value name="A">
                          <block type="variables_get">
                            <field name="VAR" id="totalProfit">Total Profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="read_details">
                            <field name="DETAIL_INDEX">4</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="trade_again" id="tradeAgainWin"></block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <!-- LOSS → martingale -->
          <block type="variables_set" id="incStep">
            <field name="VAR" id="martingaleStep">Martingale Step</field>
            <value name="VALUE">
              <block type="math_arithmetic">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="martingaleStep">Martingale Step</field>
                  </block>
                </value>
                <value name="B">
                  <block type="math_number">
                    <field name="NUM">1</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="variables_set" id="newStake">
                <field name="VAR" id="currentStake">Current Stake</field>
                <value name="VALUE">
                  <block type="math_arithmetic">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="currentStake">Current Stake</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="variables_get">
                        <field name="VAR" id="martingaleMultiplier">Martingale Multiplier</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="addLoss">
                    <field name="VAR" id="totalProfit">Total Profit</field>
                    <value name="VALUE">
                      <block type="math_arithmetic">
                        <field name="OP">ADD</field>
                        <value name="A">
                          <block type="variables_get">
                            <field name="VAR" id="totalProfit">Total Profit</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="read_details">
                            <field name="DETAIL_INDEX">4</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="trade_again" id="tradeAgainLoss"></block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <!-- ===================== TRADE OPTIONS (STAKE + DURATION + BARRIER) ===================== -->
  <block type="trade_options" id="tradeOptions" x="0" y="800">
    <field name="DURATIONTYPE_LIST">t</field>
    <field name="CURRENCY_LIST">USD</field>
    <value name="DURATION">
      <block type="math_number">
        <field name="NUM">1</field>
      </block>
    </value>
    <value name="AMOUNT">
      <block type="variables_get">
        <field name="VAR" id="currentStake">Current Stake</field>
      </block>
    </value>
    <!-- Barrier is set dynamically by the purchase block (1 for OVER, 8 for UNDER) -->
  </block>
</xml>