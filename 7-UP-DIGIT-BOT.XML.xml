<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
<?xml version="1.0" encoding="UTF-8"?>
<Strategy name="DualSide_XAUUSD_Scalper_VideoMimic" version="1.2" author="AI Bot Replica">
  
  <!-- ==================== BASIC SETTINGS ==================== -->
  <Symbol>XAUUSDm</Symbol>
  <Timeframe>TICK</Timeframe>          <!-- Works on every tick for high frequency -->
  <LotSize>1.00</LotSize>
  <MaxOpenPositions>8</MaxOpenPositions>
  <MagicNumber>20261106</MagicNumber>

  <!-- ==================== RISK MANAGEMENT ==================== -->
  <Risk>
    <MinMarginLevel>20.0</MinMarginLevel>          <!-- % - force close if below -->
    <MaxMarginLevel>200.0</MaxMarginLevel>         <!-- % - start closing oldest -->
    <EquityProtectPercent>15</EquityProtectPercent><!-- Close all if equity drops 15% from peak -->
    <MaxSpreadPoints>30</MaxSpreadPoints>
    <MaxFloatingLossPerTrade>-28.0</MaxFloatingLossPerTrade>
    <MinFreeMargin>50.0</MinFreeMargin>
  </Risk>

  <!-- ==================== ENTRY LOGIC ==================== -->
  <EntryLogic type="DualSide_Balanced">
    <Condition>
      <OpenWhen>
        total_positions &lt; MaxOpenPositions 
        AND margin_level &gt; 40 
        AND free_margin &gt; MinFreeMargin
        AND spread &lt;= MaxSpreadPoints
      </OpenWhen>
      
      <!-- Keep buy and sell sides roughly balanced -->
      <SideSelection>
        <Rule>if buy_count &lt;= sell_count then BUY else SELL</Rule>
      </SideSelection>
      
      <Slippage>3</Slippage>
      <Deviation>10</Deviation>
    </Condition>
  </EntryLogic>

  <!-- ==================== EXIT LOGIC ==================== -->
  <ExitLogic>
    <!-- Take profit quickly (matches video scalping style) -->
    <TakeProfit>
      <Type>FixedUSD</Type>
      <Value>12.0</Value>
    </TakeProfit>

    <!-- Hard stop -->
    <StopLoss>
      <Type>FixedUSD</Type>
      <Value>-28.0</Value>
    </StopLoss>

    <!-- Time-based exit for stagnant positions -->
    <TimeBasedExit>
      <MaxSeconds>90</MaxSeconds>
      <MinProfitToKeep>3.0</MinProfitToKeep>
    </TimeBasedExit>

    <!-- Force close oldest trades when margin level is too high -->
    <MarginRebalance>
      <Enabled>true</Enabled>
      <WhenMarginLevelAbove>180</WhenMarginLevelAbove>
      <CloseCount>2</CloseCount>
      <CloseOrder>OldestFirst</CloseOrder>
    </MarginRebalance>

    <!-- Emergency full close -->
    <EquityProtection>
      <Enabled>true</Enabled>
      <DropPercentFromPeak>15</DropPercentFromPeak>
      <Action>CloseAll</Action>
    </EquityProtection>
  </ExitLogic>

  <!-- ==================== POSITION MANAGEMENT ==================== -->
  <PositionManagement>
    <HedgeMode>true</HedgeMode>               <!-- Allow simultaneous BUY + SELL -->
    <AllowOppositePositions>true</AllowOppositePositions>
    <CloseOppositeOnSignal>false</CloseOppositeOnSignal>
    
    <PartialClose>
      <Enabled>false</Enabled>
    </PartialClose>
  </PositionManagement>

  <!-- ==================== MONEY MANAGEMENT ==================== -->
  <MoneyManagement>
    <PositionSizing>FixedLot</PositionSizing>
    <LotSize>1.00</LotSize>
    <MaxRiskPercentPerTrade>0</MaxRiskPercentPerTrade>  <!-- Disabled - fixed lot -->
  </MoneyManagement>

  <!-- ==================== FILTERS ==================== -->
  <Filters>
    <TradingHours>
      <Enabled>false</Enabled>                 <!-- 24/5 as seen in video -->
    </TradingHours>
    
    <NewsFilter>
      <Enabled>false</Enabled>
    </NewsFilter>
  </Filters>

  <!-- ==================== LOGGING & DEBUG ==================== -->
  <Logging>
    <LogLevel>INFO</LogLevel>
    <LogEveryTick>false</LogEveryTick>
    <LogOnTrade>true</LogOnTrade>
  </Logging>

</Strategy>